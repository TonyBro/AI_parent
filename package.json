{
  "name": "ai-parent-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm --prefix miniapp run build && wrangler deploy && node scripts/post-deploy.js",
    "d1:migrate:local": "wrangler d1 migrations apply ai_parent_bot_db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ai_parent_bot_db --remote",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251210.0",
    "@types/node": "^25.0.3",
    "typescript": "^5.7.2",
    "wrangler": "^4.60.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.88.0",
    "hono": "^4.11.1",
    "i18next": "^25.7.3",
    "react-router-dom": "^7.11.0",
    "telegram": "^2.26.22"
  }
}
