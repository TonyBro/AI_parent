</Section>
```

### 10. List Pattern

```tsx
<Section title={t("miniapp.items_title")}>
  {items.length === 0 ? (
    <div style={{ padding: "20px", textAlign: "center", color: "var(--muted)" }}>
      {t("miniapp.no_items")}
    </div>
  ) : (
    items.map((item) => (
      <ListItem
        key={item.id}
        icon={<IconComponent />}
        label={item.name}
        subtitle={item.description}
        onClick={() => onEdit?.(item.id)}
      />
    ))
  )}
  <ListItem
    icon={
      <div className="ui-avatar-small" style={{ background: 'rgba(36, 129, 204, 0.1)', color: 'var(--accent)', border: '1px solid rgba(36, 129, 204, 0.2)' }}>
        <IconPlus size={16} color="currentColor" />
      </div>
    }
    label={t("miniapp.add_new")}
    isAction
    onClick={() => onEdit?.(null)}
  />
</Section>
```

### 11. Save/Delete Buttons Pattern

```tsx
// Save button in Section (if needed on page)
<Section>
  <div style={{ padding: '0 16px 16px' }}>
    <Button
      onClick={handleSave}
      disabled={saving || !canSave}
      fullWidth
      variant="primary"
    >
      {t("miniapp.save")}
    </Button>
  </div>
</Section>

// Delete button (always danger variant)
{editingId && (
  <Section>
    <div style={{ padding: '0 16px 16px' }}>
      <Button
        onClick={handleDelete}
        disabled={saving}
        variant="danger"
        fullWidth
      >
        {t("miniapp.delete")}
      </Button>
    </div>
  </Section>
)}

// OR use ListItem for danger actions
<Section>
  <ListItem
    label={t("miniapp.delete")}
    isDanger
    onClick={handleDelete}
  />
</Section>
```

### 12. Error Display Pattern

```tsx
{error && (
  <p className="error" style={{ padding: '16px', color: 'var(--tg-red)', margin: 0 }}>
    {error}
  </p>
)}
```

### 13. Save Hook Integration (for pages with main button)

```tsx
const canSave = useMemo(() => {
  // Validation logic
  return form.name.trim() && hasChanged;
}, [form, hasChanged]);

useEffect(() => {
  if (onCanSaveChange) {
    onCanSaveChange(canSave);
  }
}, [canSave, onCanSaveChange]);

useEffect(() => {
  if (saveRef) {
    saveRef.current = handleSave;
  }
}, [handleSave, saveRef]);

// Or use useMainButton hook for pages
useMainButton({
  text: t("miniapp.save"),
  onClick: handleSave,
  isVisible: true,
  isEnabled: canSave && !saving
});
```

### 14. Back Button Integration

```tsx
useBackButton(() => {
  navigate(-1);
  // or
  onViewChange?.("previous-view");
});
```

## Complete Example Template

```tsx
import React, { useEffect, useState, useCallback, useMemo } from "react";
import { useNavigate, useParams } from "react-router-dom";
import { 
  Section, 
  ListItem, 
  FormInput,
  FormTextArea,
  Loader,
  Button,
  Page
} from "../components";
import { useTranslation } from "../i18n";
import { useBots } from "../store/BotContext";
import { useBackButton } from "../hooks/useBackButton";
import { useMainButton } from "../hooks/useMainButton";
import { getData, saveData, type DataType } from "../api";

interface ComponentProps {
  botId: string;
  view: "list" | "edit";
  editingId?: string | null;
  onViewChange?: (view: string) => void;
  onCanSaveChange?: (canSave: boolean) => void;
  saveRef?: React.MutableRefObject<() => void>;
}

export function ComponentName({ 
  botId, 
  view, 
  editingId,
  onViewChange,
  onCanSaveChange,
  saveRef
}: ComponentProps) {
  const { t, translateError } = useTranslation();
  const navigate = useNavigate();
  
  // States
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [status, setStatus] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [items, setItems] = useState<DataType[]>([]);
  const [form, setForm] = useState({
    name: "",
    description: "",
  });

  // Data loading
  const loadData = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);
      const data = await getData(botId);
      setItems(data);
    } catch (e: any) {
      setError(translateError(e));
    } finally {
      setLoading(false);
    }
  }, [botId, translateError]);

  useEffect(() => {
    loadData();
  }, [loadData]);

  // Form initialization for edit
  useEffect(() => {
    if (view === "edit" && editingId) {
      const item = items.find(i => i.id === editingId);
      if (item) {
        setForm({
          name: item.name,
          description: item.description,
        });
      }
    } else if (view === "edit" && !editingId) {
      // Reset for new
      setForm({ name: "", description: "" });
    }
  }, [view, editingId, items]);

  // Validation
  const canSave = useMemo(() => {
    return form.name.trim() && form.description.trim();
  }, [form]);

  useEffect(() => {
    if (onCanSaveChange) {
      onCanSaveChange(canSave);
    }
  }, [canSave, onCanSaveChange]);

  // Save handler
  const handleSave = useCallback(async () => {
    if (!canSave) return;
    setSaving(true);
    setStatus(t("miniapp.saving"));
    try {
      setError(null);
      await saveData(botId, editingId || undefined, form);
      await loadData();
      onViewChange?.("list");
    } catch (e: any) {
      setError(translateError(e));
    } finally {
      setSaving(false);
      setStatus("");
    }
  }, [botId, editingId, form, canSave, loadData, onViewChange, t, translateError]);

  useEffect(() => {
    if (saveRef) {
      saveRef.current = handleSave;
    }
  }, [handleSave, saveRef]);

  useBackButton(() => {
    onViewChange?.("list");
  });

  // Loading state
  if (loading) {
    return <Loader text={t("miniapp.loading")} />;
  }

  // Render
  const renderContent = () => {
    if (view === "list") {
      return (
        <div>
          <Section title={t("miniapp.items")}>
            {items.length === 0 ? (
              <div style={{ padding: "20px", textAlign: "center", color: "var(--muted)" }}>
                {t("miniapp.no_items")}
              </div>
            ) : (
              items.map((item) => (
                <ListItem
                  key={item.id}
                  label={item.name}
                  subtitle={item.description}
                  onClick={() => onViewChange?.("edit")}
                />
              ))
            )}
          </Section>
        </div>
      );
    }

    return (
      <div>
        {error && <p className="error" style={{ padding: '16px', color: 'var(--tg-red)', margin: 0 }}>{error}</p>}
        
        {/* DEFAULT PATTERN: Section title + plain input */}
        <Section title={t("miniapp.name")}>
          <FormInput
            value={form.name}
            onChange={(e) => setForm({ ...form, name: e.target.value })}
            placeholder={t("miniapp.name_placeholder")}
          />
        </Section>

        <Section title={t("miniapp.description")}>
          <FormTextArea
            value={form.description}
            onChange={(e) => setForm({ ...form, description: e.target.value })}
            placeholder={t("miniapp.description_placeholder")}
            rows={4}
          />
        </Section>
      </div>
    );
  };

  return (
    <>
      {saving && <Loader fullscreen text={status} />}
      {renderContent()}
    </>
  );
}
```

## Key Rules Summary

1. ✅ **ALWAYS** import from `./components` or `../components`
2. ✅ **ALWAYS** use `Loader` component for loading states
3. ✅ **ALWAYS** use `<Section title="...">` + plain inputs (FormInput/FormTextArea/CustomSelect) as DEFAULT pattern
4. ✅ **ALWAYS** wrap each form field in its own `Section` for visual separation
5. ✅ **ALWAYS** use Section `title` prop for field labels (not FormField/FormTextAreaField/FormSelectField)
6. ⚠️ **ONLY** use `FormField`, `FormTextAreaField`, `FormSelectField` when you need label + hint together inside section
7. ✅ **ALWAYS** use `Button` component with proper `variant` prop
8. ✅ **ALWAYS** use `translateError()` for error messages
9. ✅ **ALWAYS** use `useCallback` for async functions
10. ✅ **ALWAYS** use `useMemo` for derived/computed values
11. ✅ **NEVER** hardcode strings - use `t("key")` for all text
12. ✅ **NEVER** create inline styles for buttons, inputs, or forms - use components
13. ✅ **NEVER** use `window.confirm()` - use `ConfirmModal` component
14. ✅ **NEVER** put all form fields in one continuous Section - separate them
